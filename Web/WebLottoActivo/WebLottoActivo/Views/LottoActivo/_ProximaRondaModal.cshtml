@using WebLottoActivo.Models.ViewModels
@model ProximaRondaViewModel

@if (Model == null || Model.Items == null || !Model.Items.Any())
{
    <div class="alert alert-warning mb-0">No hay resultados registrados todavía.</div>
}
else
{
    <div class="d-flex align-items-center flex-wrap gap-2 mb-3">
        <span class="fw-bold">Último sorteo:</span>
        <img src="data:image/png;base64,@Model.UltimoAnimalImageB64" style="max-width:36px; max-height:36px;" class="rounded" title="@Model.UltimoAnimalNombre" />
        <span class="fw-bold">@Model.UltimoAnimalNombre</span>
        <span class="text-muted">@Model.UltimaFecha @Model.UltimaHora</span>
        <span class="badge bg-primary">Desplazamiento @Model.UltimoDesplazamiento</span>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-sm table-striped mb-0 proxima-ronda-horizontal">
            <thead class="table-info">
                <tr>
                    <th class="text-center align-middle">Desp.</th>
                    @foreach (var item in Model.Items)
                    {
                        <th class="text-center">@item.Offset.ToString("D2")</th>
                    }
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th class="text-center align-middle">Izq.</th>
                    @foreach (var item in Model.Items)
                    {
                        <td class="text-center align-middle">
                            <img src="data:image/png;base64,@item.AnimalIzqImageB64" class="rounded" title="@item.AnimalIzqNombre" />
                            <small class="d-block">@item.AnimalIzqNombre</small>
                        </td>
                    }
                </tr>
                <tr>
                    <th class="text-center align-middle">Der.</th>
                    @foreach (var item in Model.Items)
                    {
                        <td class="text-center align-middle">
                            <img src="data:image/png;base64,@item.AnimalDerImageB64" class="rounded" title="@item.AnimalDerNombre" />
                            <small class="d-block">@item.AnimalDerNombre</small>
                        </td>
                    }
                </tr>
            </tbody>
        </table>
    </div>
}
