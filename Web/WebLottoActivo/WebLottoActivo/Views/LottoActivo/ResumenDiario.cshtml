@using WebLottoActivo.Models.ViewModels
@model ResumenDiario

@{
    ViewData["Title"] = "Index";
    var today = Model.Today;
    var yesterday = Model.Yesterday;
    int columnasPorFila = 3;
}

<div class="container mt-4 page-bottom-padding">
    <h2 class="mb-4">
        <i class="bi bi-clipboard2-check"></i> Resumen Diario
    </h2>

    <form method="post" asp-action="ResumenDiario" class="mb-3" id="formResumenDiario">
        <div class="row g-2">
            <div class="col-12 col-md-4">
                <label for="fecha" class="form-label fw-bold">Seleccione la fecha:</label>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary" id="btnDiaAnterior" title="Día anterior">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <input type="date" name="date" id="fecha" class="form-control" value="@ViewBag.Today" />
                    <button type="button" class="btn btn-outline-secondary" id="btnDiaSiguiente" title="Día siguiente">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
            <div class="col-12 col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Buscar</button>
            </div>
            <div class="col-12 col-md-2 d-flex align-items-end">
                <button type="button" class="btn btn-outline-primary w-100" data-bs-toggle="modal" data-bs-target="#modalProximaRonda">
                    <i class="bi bi-compass"></i> Próxima ronda
                </button>
            </div>
        </div>
    </form>
    <hr style="border: 1px solid #ccc; margin: 20px 0;" />
    <div class="row">
        <!-- Repeated animals container -->
        <div class="col-12 mb-3">
            <div class="card">
                <div class="card-body d-flex flex-wrap align-items-center">
                    <h6 class="me-3 mb-0">Animales repetidos entre las dos fechas:</h6>
                    @if (Model.Repeated != null && Model.Repeated.Any())
                    {
                        foreach (var item in Model.Repeated)
                        {
                            var cnt = Model.RepeatedCounts != null && Model.RepeatedCounts.ContainsKey(item.LottoActivoAnimalId) ? Model.RepeatedCounts[item.LottoActivoAnimalId] : 1;
                            <div class="position-relative d-flex flex-column align-items-center me-3 text-center">
                                <img src="data:image/png;base64,@item.ImageB64" style="max-width:48px; max-height:48px;" class="rounded" title="@item.Nombre" />
                                @if (cnt > 1)
                                {
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">@cnt</span>
                                }
                                <small class="d-block">@item.Nombre</small>
                            </div>
                        }
                    }
                    else
                    {
                        <span class="text-muted">No hay animales repetidos entre las fechas seleccionadas.</span>
                    }
                </div>
            </div>
        </div>
        <!-- Tabla de Hoy -->
        <div class="col-12 col-lg-6">
            <h5 class="text-center">@ViewBag.Yesterday</h5>
            <div class="table-responsive">
                <table class="table table-bordered table-hover table-striped">
                    <thead class="table-info">
                        <tr>
                            @for (int i = 0; i < columnasPorFila; i++)
                            {
                                <th class="text-center">Animal</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < yesterday.Count; i += columnasPorFila)
                        {
                            <tr>
                                @for (int j = i; j < i + columnasPorFila; j++)
                                {
                                    if (j < yesterday.Count)
                                    {
                                        var row = yesterday[j];
                                        <td class="text-center align-middle">
                                            <div class="d-flex flex-column align-items-center">
                                                <img src="data:image/png;base64,@row.ImageB64"
                                                     alt="Imagen"
                                                     class="img-fluid"
                                                     style="max-width:75px; max-height:75px;" />
                                                <span class="mt-2 fw-bold text-wrap text-center">@row.Nombre</span>
                                                <span class="fw-light text-muted">@row.Hora</span>
                                                @if (@row.IsFlag)
                                                {
                                                    <span class="fw-bold text-danger">(@row.Desplazamiento)</span>
                                                }
                                                else
                                                {
                                                    <span class="fw-light text-muted">(@row.Desplazamiento)</span>
                                                }
                                            </div>
                                        </td>
                                    }
                                    else
                                    {
                                        <td></td>
                                    }
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Tabla de Ayer -->
        <div class="col-12 col-lg-6">
            <h5 class="text-center">@ViewBag.Today</h5>
            <div class="table-responsive">
                <table class="table table-bordered table-hover table-striped">
                    <thead class="table-info">
                        <tr>
                            @for (int i = 0; i < columnasPorFila; i++)
                            {
                                <th class="text-center">Animal</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < today.Count; i += columnasPorFila)
                        {
                            <tr>
                                @for (int j = i; j < i + columnasPorFila; j++)
                                {
                                    if (j < today.Count)
                                    {
                                        var row = today[j];
                                        <td class="text-center align-middle">
                                            <div class="d-flex flex-column align-items-center">
                                                <img src="data:image/png;base64,@row.ImageB64"
                                                     alt="Imagen"
                                                     class="img-fluid"
                                                     style="max-width:75px; max-height:75px;" />
                                                <span class="mt-2 fw-bold text-wrap text-center">@row.Nombre</span>
                                                <span class="fw-light text-muted">@row.Hora</span>
                                                @if(@row.IsFlag)
                                                {
                                                    <span class="fw-bold text-danger">(@row.Desplazamiento)</span>
                                                }
                                                else
                                                {
                                                    <span class="fw-light text-muted">(@row.Desplazamiento)</span>
                                                }

                                            </div>
                                        </td>
                                    }
                                    else
                                    {
                                        <td></td>
                                    }
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Próxima Ronda -->
<div class="modal fade" id="modalProximaRonda" tabindex="-1" aria-labelledby="modalProximaRondaLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalProximaRondaLabel"><i class="bi bi-compass"></i> Próxima Ronda</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="modalProximaRondaBody"></div>
        </div>
    </div>
</div>

<style>
    .proxima-ronda-horizontal img {
        max-width: 28px;
        max-height: 28px;
    }

    .proxima-ronda-horizontal td,
    .proxima-ronda-horizontal th {
        white-space: nowrap;
        font-size: 0.75rem;
        padding: 0.25rem;
    }
</style>

@section Scripts {
    <script>
        document.getElementById('modalProximaRonda').addEventListener('show.bs.modal', function () {
            var body = document.getElementById('modalProximaRondaBody');
            body.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></div>';

            fetch('@Url.Action("ProximaRondaModal", "LottoActivo")')
                .then(function (r) {
                    if (!r.ok) throw new Error(r.status);
                    return r.text();
                })
                .then(function (html) { body.innerHTML = html; })
                .catch(function () {
                    body.innerHTML = '<div class="alert alert-danger mb-0">No se pudo cargar la próxima ronda.</div>';
                });
        });

        function cambiarDia(delta) {
            var input = document.getElementById('fecha');
            var partes = input.value.split('-');
            var fecha = new Date(parseInt(partes[0]), parseInt(partes[1]) - 1, parseInt(partes[2]));
            fecha.setDate(fecha.getDate() + delta);

            var yyyy = fecha.getFullYear();
            var mm = String(fecha.getMonth() + 1).padStart(2, '0');
            var dd = String(fecha.getDate()).padStart(2, '0');

            input.value = yyyy + '-' + mm + '-' + dd;
            document.getElementById('formResumenDiario').submit();
        }

        document.getElementById('btnDiaAnterior').addEventListener('click', function () { cambiarDia(-1); });
        document.getElementById('btnDiaSiguiente').addEventListener('click', function () { cambiarDia(1); });
    </script>
}
