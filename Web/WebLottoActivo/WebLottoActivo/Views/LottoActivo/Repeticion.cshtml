@using WebLottoActivo.Models.ViewModels
@model RepeticionViewModel
@{
    ViewData["Title"] = "Repetición entre días";
    var pendientes = Model.Candidatos.Where(c => !c.YaSalio).ToList();
    var salieron = Model.Candidatos.Where(c => c.YaSalio).ToList();
    double esperados = Model.Candidatos.Count * Model.TasaHistorica;
}

<div class="container mt-4 page-bottom-padding">
    <h2 class="mb-4"><i class="bi bi-arrow-repeat"></i> Repetición entre días</h2>

    <form method="get" asp-action="Repeticion" class="mb-3" id="formRepeticion">
        <div class="row g-2">
            <div class="col-12 col-md-4">
                <label for="fecha" class="form-label fw-bold">Fecha:</label>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary" id="btnDiaAnterior" title="Día anterior">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <input type="date" name="date" id="fecha" class="form-control" value="@Model.Fecha" />
                    <button type="button" class="btn btn-outline-secondary" id="btnDiaSiguiente" title="Día siguiente">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <label for="desfase" class="form-label fw-bold">Comparar con:</label>
                <select name="desfase" id="desfase" class="form-select">
                    @for (int i = 1; i <= 3; i++)
                    {
                        <option value="@i" selected="@(i == Model.Desfase)">Hace @i día@(i > 1 ? "s" : "")</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label for="ventana" class="form-label fw-bold">Ventana:</label>
                <select name="ventana" id="ventana" class="form-select">
                    @foreach (var d in new[] { 7, 15, 30, 45, 60 })
                    {
                        <option value="@d" selected="@(d == Model.Ventana)">Últimos @d días</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Buscar</button>
            </div>
        </div>
    </form>
    <hr style="border: 1px solid #ccc; margin: 20px 0;" />

    <!-- Resumen estadístico -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Repiten a @Model.Desfase día@(Model.Desfase > 1 ? "s" : "") (últimos @Model.Ventana días)</div>
                    <div class="fs-3 fw-bold">@Model.TasaHistorica.ToString("P1")</div>
                    <div class="small text-muted">Referencia sin relación: @Model.TasaBase.ToString("P1") · @Model.DiasAnalizados días</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Animalitos del @Model.FechaOrigen</div>
                    <div class="fs-3 fw-bold">@Model.Candidatos.Count</div>
                    <div class="small text-muted">Se esperan ≈ @esperados.ToString("0.0") repetidos el @Model.Fecha</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Ya repetidos el @Model.Fecha</div>
                    <div class="fs-3 fw-bold text-success">@salieron.Count</div>
                    <div class="small text-muted">Pendientes: @pendientes.Count</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Candidatos -->
    <div class="card mb-4">
        <div class="card-header fw-bold">Candidatos a salir (salieron el @Model.FechaOrigen)</div>
        <div class="card-body">
            @if (!Model.Candidatos.Any())
            {
                <span class="text-muted">No hay resultados para el @Model.FechaOrigen.</span>
            }
            else
            {
                <div class="d-flex flex-wrap gap-3">
                    @foreach (var c in pendientes)
                    {
                        <div class="text-center candidato">
                            <img src="data:image/png;base64,@c.ImageB64" class="rounded" title="@c.Nombre" />
                            <small class="d-block fw-bold">@c.Nombre</small>
                            <small class="d-block text-muted">@c.HorasOrigen</small>
                        </div>
                    }
                </div>

                @if (salieron.Any())
                {
                    <hr />
                    <h6 class="text-success"><i class="bi bi-check-circle"></i> Ya repitieron</h6>
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var c in salieron)
                        {
                            <div class="text-center candidato">
                                <img src="data:image/png;base64,@c.ImageB64" class="rounded opacity-50" title="@c.Nombre" />
                                <small class="d-block fw-bold">@c.Nombre</small>
                                <small class="d-block text-muted">@c.HorasOrigen</small>
                                <span class="badge bg-success">Hoy @c.HoraHoy</span>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>

    <!-- Patrones -->
    <div class="card mb-4">
        <div class="card-header fw-bold">Patrones por hora (origen @Model.FechaOrigen → @Model.Fecha)</div>
        <div class="card-body">
            @if (TempData["PatronError"] != null)
            {
                <div class="alert alert-danger py-2">@TempData["PatronError"]</div>
            }

            <form method="post" asp-action="CrearPatron" class="mb-3">
                <input type="hidden" name="date" value="@Model.Fecha" />
                <input type="hidden" name="desfase" value="@Model.Desfase" />
                <input type="hidden" name="ventana" value="@Model.Ventana" />
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-md-2">
                        <label for="codigo" class="form-label fw-bold small mb-1">Código</label>
                        <input type="text" name="codigo" id="codigo" class="form-control form-control-sm" placeholder="A-001" maxlength="20" required />
                    </div>
                    <div class="col-12 col-md-8">
                        <label class="form-label fw-bold small mb-1">Horas</label>
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var h in Model.HorasSorteo)
                            {
                                var id = "hora_" + h.Replace(":", "");
                                <input type="checkbox" class="btn-check" name="horas" value="@h" id="@id" autocomplete="off" />
                                <label class="btn btn-outline-secondary btn-sm" for="@id">@h</label>
                            }
                        </div>
                    </div>
                    <div class="col-12 col-md-2">
                        <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-plus-lg"></i> Agregar</button>
                    </div>
                </div>
            </form>

            @if (!Model.Patrones.Any())
            {
                <span class="text-muted">No hay patrones guardados. Agrega uno con el formulario de arriba.</span>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-sm table-hover align-middle mb-0">
                        <thead class="table-info">
                            <tr>
                                <th class="text-center">Historial</th>
                                <th class="text-center">Código</th>
                                <th class="text-center">Animalitos para el @Model.Fecha</th>
                                <th class="text-center">Veces (@Model.Ventana días)</th>
                                <th class="text-center">Días sin salir</th>
                                <th class="text-center">Última vez</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.Patrones)
                            {
                                var completo = p.Animalitos.Any() && p.Salieron == p.Animalitos.Count;
                                <tr class="@(completo ? "table-success" : "")">
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#historialPatronModal"
                                                data-id="@p.Id" data-codigo="@p.Codigo" data-horas="@string.Join(", ", p.Horas)" title="Ver historial">
                                            <i class="bi bi-clock-history"></i>
                                        </button>
                                        <div class="small text-muted mt-1">@p.VecesTotal veces</div>
                                    </td>
                                    <td class="text-center fw-bold">@p.Codigo</td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-2 justify-content-center">
                                            @foreach (var a in p.Animalitos)
                                            {
                                                <div class="text-center candidato">
                                                    @if (a.ImageB64 != null)
                                                    {
                                                        <img src="data:image/png;base64,@a.ImageB64" class="rounded @(a.YaSalio ? "opacity-50" : "")" title="@a.Nombre" />
                                                        <small class="d-block fw-bold">@a.Nombre</small>
                                                    }
                                                    else
                                                    {
                                                        <small class="d-block text-muted">—</small>
                                                    }
                                                    <small class="d-block text-muted">@a.HorasOrigen</small>
                                                    @if (a.YaSalio)
                                                    {
                                                        <span class="badge bg-success">Hoy @a.HoraHoy</span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                        <div class="text-center small text-muted">Han salido @p.Salieron de @p.Animalitos.Count</div>
                                    </td>
                                    <td class="text-center fs-5 fw-bold">@p.Veces</td>
                                    <td class="text-center">@(p.DiasSinSalir?.ToString() ?? "Nunca")</td>
                                    <td class="text-center">@(p.UltimaFecha ?? "—")</td>
                                    <td class="text-center">
                                        <form method="post" asp-action="EliminarPatron" onsubmit="return confirm('¿Eliminar el patrón @p.Codigo?');">
                                            <input type="hidden" name="id" value="@p.Id" />
                                            <input type="hidden" name="date" value="@Model.Fecha" />
                                            <input type="hidden" name="desfase" value="@Model.Desfase" />
                                            <input type="hidden" name="ventana" value="@Model.Ventana" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Eliminar"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="small text-muted mt-2 mb-0">
                    Un patrón <b>sale</b> cuando los animalitos de todas sus horas vuelven a salir @Model.Desfase día(s) después.
                    "Última vez" es el día en que se completó.
                </p>
            }
        </div>
    </div>

    <!-- Estadística por hora -->
    <div class="row g-3">
        <div class="col-12 col-lg-6">
            <h6 class="fw-bold">¿A qué hora cae la repetición? <small class="text-muted fw-normal">(últimos @Model.Ventana días)</small></h6>
            <p class="small text-muted mb-2">% de sorteos de cada hora cuyo animalito ya había salido @Model.Desfase día(s) antes.</p>
            @await Html.PartialAsync("_RepeticionHoraTabla", Model.PorHoraDestino)
        </div>
        <div class="col-12 col-lg-6">
            <h6 class="fw-bold">¿De qué hora vienen los que repiten? <small class="text-muted fw-normal">(últimos @Model.Ventana días)</small></h6>
            <p class="small text-muted mb-2">% de animalitos salidos a cada hora que vuelven a salir @Model.Desfase día(s) después.</p>
            @await Html.PartialAsync("_RepeticionHoraTabla", Model.PorHoraOrigen)
        </div>
    </div>
</div>

<!-- Modal historial del patrón -->
<div class="modal fade" id="historialPatronModal" tabindex="-1" aria-labelledby="historialPatronModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="historialPatronModalLabel">Historial del patrón</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="small text-muted mb-2" id="historialPatronInfo"></p>
        <table id="historialPatronTable" class="table table-sm table-striped align-middle">
          <thead><tr><th>Fecha</th><th>Origen</th><th>Días</th><th>Animalitos</th></tr></thead>
          <tbody></tbody>
        </table>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

<style>
    .candidato { width: 72px; }
    .candidato img { max-width: 40px; max-height: 40px; }
    .candidato small { font-size: 0.7rem; }
</style>

@section Scripts {
    <script>
        function cambiarDia(delta) {
            var input = document.getElementById('fecha');
            var partes = input.value.split('-');
            var fecha = new Date(parseInt(partes[0]), parseInt(partes[1]) - 1, parseInt(partes[2]));
            fecha.setDate(fecha.getDate() + delta);

            var yyyy = fecha.getFullYear();
            var mm = String(fecha.getMonth() + 1).padStart(2, '0');
            var dd = String(fecha.getDate()).padStart(2, '0');

            input.value = yyyy + '-' + mm + '-' + dd;
            document.getElementById('formRepeticion').submit();
        }

        $(document).ready(function () {
            var historialTable = $('#historialPatronTable').DataTable({
                paging: true,
                pageLength: 10,
                ordering: false,
                searching: false,
                info: false,
                language: { emptyTable: 'Este patrón no ha salido todavía.' }
            });

            $('#historialPatronModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                $('#historialPatronModalLabel').text('Historial del patrón ' + button.data('codigo'));
                $('#historialPatronInfo').text('Horas: ' + button.data('horas') + ' · antes del @Model.Fecha');
                historialTable.clear().draw();
                $.getJSON('@Url.Action("HistorialPatron")', { id: button.data('id'), date: '@Model.Fecha', desfase: @Model.Desfase }, function (data) {
                    data.forEach(function (r) {
                        var animalitos = '<div class="d-flex flex-wrap gap-2">' + r.animalitos.map(function (a) {
                            var img = a.imageB64
                                ? '<img src="data:image/png;base64,' + a.imageB64 + '" title="' + (a.nombre || '') + '" style="max-width:32px; max-height:32px;" class="rounded" />'
                                : '';
                            return '<div class="text-center candidato">' + img +
                                '<small class="d-block fw-bold">' + (a.nombre || '') + '</small>' +
                                '<small class="d-block text-muted">' + a.horasOrigen + ' → ' + a.horaHoy + '</small></div>';
                        }).join('') + '</div>';
                        var dias = r.dias == null ? '<span class="text-muted">Primera</span>' : '<b>' + r.dias + '</b>';
                        historialTable.row.add([r.fecha, r.fechaOrigen, dias, animalitos]);
                    });
                    historialTable.draw();
                });
            });
        });

        document.getElementById('btnDiaAnterior').addEventListener('click', function () { cambiarDia(-1); });
        document.getElementById('btnDiaSiguiente').addEventListener('click', function () { cambiarDia(1); });
    </script>
}
