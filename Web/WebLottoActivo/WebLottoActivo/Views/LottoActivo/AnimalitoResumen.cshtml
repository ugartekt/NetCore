@using WebLottoActivo.Models.ViewModels
@model List<AnimalitoResumen>
@{
    ViewData["Title"] = "Animalito Resumen";
}

<div class="container mt-4 page-bottom-padding">
    <h2 class="mb-4"><i class="bi bi-egg-fried"></i> Animalito Resumen</h2>
    <form method="get" asp-action="AnimalitoResumen" class="mb-3">
        <div class="row align-items-center g-2">
            <div class="col-auto">
                <label for="monthSelect" class="form-label fw-bold">Mes:</label>
            </div>
            <div class="col-auto">
                <select name="month" id="monthSelect" class="form-select" onchange="this.form.submit()">
                    @{ 
                        int selectedMonth = ViewBag.SelectedMonth != null ? (int)ViewBag.SelectedMonth : DateTime.Today.Month; 
                    }
                    @for (int m = 1; m <= 12; m++)
                    {
                        if (m == selectedMonth)
                        {
                            <option value="@m" selected>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                        }
                        else
                        {
                            <option value="@m">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                        }
                    }
                </select>
            </div>
            <div class="col-auto">
                <label for="yearSelect" class="form-label fw-bold">Año:</label>
            </div>
            <div class="col-auto">
                <select name="year" id="yearSelect" class="form-select" onchange="this.form.submit()">
                    @{ 
                        int selectedYear = ViewBag.SelectedYear != null ? (int)ViewBag.SelectedYear : DateTime.Today.Year; 
                        var startYear = selectedYear - 2; var endYear = selectedYear; 
                    }
                    @for (int y = startYear; y <= endYear; y++)
                    {
                        if (y == selectedYear)
                        {
                            <option value="@y" selected>@y</option>
                        }
                        else
                        {
                            <option value="@y">@y</option>
                        }
                    }
                </select>
            </div>
        </div>
    </form>

    <div class="table-responsive">
        <table id="animalitoResumen" class="table table-sm table-bordered table-hover table-striped">
        <thead class="table-info">
            <tr>
                <th>Detalles</th>
                <th>Animalito</th>
                <th>Animalitos Posteriores</th>
                <th>Cantidad</th>
                <th>Ultima Fecha</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model)
            {
                <tr>
                    <td class="text-center align-middle">
                        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#occModal" data-animalid="@row.AnimalId" title="Ver historial">
                            <i class="bi bi-clock-history" aria-hidden="true"></i>
                        </button>
                        <div class="small text-muted mt-1">
                            @{ 
                                var countByAnimal = ViewBag.CountByAnimal as Dictionary<int,int>;
                                var times = countByAnimal != null && countByAnimal.ContainsKey(row.AnimalId) ? countByAnimal[row.AnimalId] : row.Cantidad;
                            }
                            @times veces
                        </div>
                    </td>

                    <td class="align-middle">
                        <div class="d-flex flex-row align-items-center gap-2">
                            <img src="data:image/png;base64,@row.ImageB64" alt="Imagen" class="img-fluid rounded" style="max-width:48px; max-height:48px;" />
                            <div class="d-flex flex-column text-start">
                                <span class="fw-bold text-wrap">@row.Nombre</span>
                                <span class="fw-bold text-muted">(@row.AnimalId)</span>
                            </div>
                        </div>
                    </td>

                    <td>
                        <div class="d-flex flex-wrap">
                            @foreach(var ap in row.AnimalPosteriores)
                            {
                                <div class="me-2 text-center">
                                    <img src="data:image/png;base64,@ap.ImageB64" alt="@ap.Nombre" class="rounded" style="max-width:36px; max-height:36px;" title="@ap.Nombre" />
                                </div>
                            }
                        </div>
                    </td>
                    <td class="align-middle text-center">@row.Cantidad</td>
                    <td class="align-middle text-center">@row.UltimaFecha</td>
                </tr>
            }
        </tbody>
        </table>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="occModal" tabindex="-1" aria-labelledby="occModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="occModalLabel">Historial de Apariciones</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div id="occContent">
          <table id="occTable" class="table table-sm table-striped">
            <thead><tr><th>Fecha</th><th>Hora</th><th>Desplazamiento</th><th>Animalito</th><th>Días</th></tr></thead>
            <tbody></tbody>
          </table>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#animalitoResumen').DataTable({
                pageLength: 25,
                order: [[1, 'desc']],
                language: {
                 url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'
                }
            });

            var occTable = $('#occTable').DataTable({
                paging: true,
                pageLength: 10,
                ordering: false,
                searching: false,
                info: false
            });

            $('#occModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var animalId = button.data('animalid');
                var year = $('#yearSelect').val();
                var month = $('#monthSelect').val();
                // fetch occurrences via API for selected month
                occTable.clear().draw();
                $.getJSON('/LottoActivo/Occurrences', { animalId: animalId, year: year, month: month }, function (data) {
                    data.forEach(function (r) {
                        var imgHtml = r.animalPosteriorImageB64
                            ? '<img src="data:image/png;base64,' + r.animalPosteriorImageB64 + '" title="' + (r.animalPosteriorNombre || '') + '" style="max-width:32px; max-height:32px;" class="rounded" />'
                            : '';
                        occTable.row.add([r.fecha, r.hora, r.desplazamiento, imgHtml, r.dias]).draw(false);
                    });
                });
            });
        });
    </script>
}
