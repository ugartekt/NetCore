@using WebLottoActivo.Models.ViewModels
@model ProximaRondaViewModel
@{
    ViewData["Title"] = "Proxima Ronda";
}

<div class="container mt-4 page-bottom-padding">
    <h2 class="mb-4"><i class="bi bi-compass"></i> Próxima Ronda</h2>

    @if (Model == null || Model.Items == null || !Model.Items.Any())
    {
        <div class="alert alert-warning">No hay resultados registrados todavía.</div>
    }
    else
    {
        <div class="card mb-4">
            <div class="card-body d-flex align-items-center flex-wrap gap-3">
                <span class="fw-bold">Último sorteo:</span>
                <img src="data:image/png;base64,@Model.UltimoAnimalImageB64" style="max-width:56px; max-height:56px;" class="rounded" title="@Model.UltimoAnimalNombre" />
                <span class="fw-bold">@Model.UltimoAnimalNombre</span>
                <span class="text-muted">@Model.UltimaFecha @Model.UltimaHora</span>
                <span class="badge bg-primary">Desplazamiento @Model.UltimoDesplazamiento</span>
            </div>
        </div>

        <p class="text-muted">
            Animalitos ubicados a cada distancia del último resultado en la rueda de "Lotto Activo" (izquierda y derecha).
        </p>

        <div class="table-responsive">
            <table class="table table-bordered table-hover table-striped">
                <thead class="table-info">
                    <tr>
                        <th class="text-center">Desplazamiento</th>
                        <th class="text-center">Izquierda</th>
                        <th class="text-center">Derecha</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="text-center align-middle fw-bold">@item.Offset.ToString("D2")</td>
                            <td class="text-center align-middle">
                                <div class="d-flex flex-column align-items-center">
                                    <img src="data:image/png;base64,@item.AnimalIzqImageB64" style="max-width:48px; max-height:48px;" class="rounded" />
                                    <span>@item.AnimalIzqNombre</span>
                                </div>
                            </td>
                            <td class="text-center align-middle">
                                <div class="d-flex flex-column align-items-center">
                                    <img src="data:image/png;base64,@item.AnimalDerImageB64" style="max-width:48px; max-height:48px;" class="rounded" />
                                    <span>@item.AnimalDerNombre</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
